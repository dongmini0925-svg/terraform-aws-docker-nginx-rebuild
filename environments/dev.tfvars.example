aws_region = "ap-northeast-2"

project_name = "docker-nginx-dev"

vpc_cidr = "10.10.0.0/16"

public_subnet_cidrs = [
  "10.10.1.0/24",
  "10.10.2.0/24"
]

availability_zones = [
  "ap-northeast-2a",
  "ap-northeast-2c"
]

instance_type = "t3.micro"
key_name      = "MyWEB_Key"

asg_min_size         = 1
asg_desired_capacity = 1
asg_max_size         = 2

alert_email = "your-email@example.com"

