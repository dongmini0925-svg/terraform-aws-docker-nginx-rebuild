aws_region = "ap-northeast-2"

project_name = "docker-nginx-prod"

vpc_cidr = "10.20.0.0/16"

public_subnet_cidrs = [
  "10.20.1.0/24",
  "10.20.2.0/24"
]

availability_zones = [
  "ap-northeast-2a",
  "ap-northeast-2c"
]

instance_type = "t3.small"
key_name      = "MyWEB_Key"

asg_min_size         = 2
asg_desired_capacity = 2
asg_max_size         = 4

alert_email = "your-email@example.com"

